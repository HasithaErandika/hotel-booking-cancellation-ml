# =====================================================================
# Hotel Booking Cancellation ML — .gitignore
# Tracked on purpose: raw data (data/hotel_bookings.csv), docs/, notebooks/,
# artifacts/*.json contracts and reports/ (evidence behind the final report).
# =====================================================================

# --- Python bytecode / caches ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual environments / env files ------------------------------
.venv/
venv/
env/
ENV/
.python-version
.env
.env.*
!.env.example

# --- Jupyter -------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
profile_default/
ipython_config.py

# --- Generated data (re-created by notebooks 01, 02, 04) -----------
data/interim/
data/processed/
# Keep the immutable raw dataset tracked
!data/hotel_bookings.csv

# --- Model binaries (re-created by notebooks 04-09, 12) ------------
models/
*.joblib
*.pkl
*.pickle
# SHAP / joblib caches
cachedir/
joblib_cache/

# --- Experiment tracking (future: MLflow, see plan.md F-02) --------
mlruns/
mlartifacts/

# --- Large per-row prediction dumps (regenerated by notebook 14) ----
reports/tables/14_test_predictions.csv

# --- Testing / linting / type-checking caches ----------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Packaging ------------------------------------------------------
build/
dist/
*.egg-info/

# --- IDE / editor --------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- OS -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp ---------------------------------------------------
*.log
*.tmp
tmp/
